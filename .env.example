# Copy this file to .env and fill in values locally.
# Credentials stay on the Python server; never commit a filled .env file.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=pipelinehub-support
# Create a dense index for external embeddings: 384 dimensions, cosine metric.
# Embeddings run locally with BAAI/bge-small-en-v1.5; no Nebius key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
GENERATION_PROVIDER=nebius
NEBIUS_MODEL=Qwen/Qwen3.5-397B-A17B
NEBIUS_API_KEY=
